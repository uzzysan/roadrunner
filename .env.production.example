# Template for .env.production — used by infra/docker-compose.prod.yml and the app itself.
# infra/install.sh generates a real .env.production automatically on first run (with random
# DB_PASSWORD/JWT_SECRET) and only prompts for DOMAIN and ACME_EMAIL; this file exists as a
# reference and for anyone setting the file up by hand instead.

# The domain this server is reachable at (Caddy requests its TLS cert for this automatically —
# point the domain's DNS A record at this server's IP before starting the stack).
DOMAIN=transit.example-carrier.com

# Used only for Let's Encrypt expiry/problem notices, never shown publicly.
ACME_EMAIL=admin@example-carrier.com

# Database. Note the host is "postgres" (the compose service name), not "localhost" — the api
# container reaches the database over the internal Docker network, not the host's loopback.
DB_USER=roadrunner
DB_PASSWORD=CHANGE_THIS_TO_A_RANDOM_VALUE
DB_NAME=roadrunner
DATABASE_URL=postgres://roadrunner:CHANGE_THIS_TO_A_RANDOM_VALUE@postgres:5432/roadrunner

JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING
JWT_EXPIRATION=86400
PORT=3000
HOST=0.0.0.0
RUST_LOG=info
