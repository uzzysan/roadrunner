# Database
DB_USER=roadrunner
DB_PASSWORD=
DB_APP_USER=roadrunner_runtime
DB_APP_PASSWORD=
DB_NAME=roadrunner
DATABASE_URL=postgres://roadrunner_runtime:<runtime-password>@localhost:5432/roadrunner
MIGRATION_DATABASE_URL=postgres://roadrunner:<owner-password>@localhost:5432/roadrunner
DEFAULT_CARRIER_ID=00000000-0000-4000-8000-000000000001

# Server
PORT=3000
HOST=0.0.0.0
RUST_LOG=debug

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=86400

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-here
